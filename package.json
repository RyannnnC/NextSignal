{
  "name": "nextsignal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:auth": "npm run dev",
    "dev:fixture": "tsx scripts/dev.ts --fixture",
    "auth:setup": "tsx scripts/setup-auth-local.ts",
    "auth:up": "tsx scripts/start-auth-local.ts",
    "db:backup": "tsx scripts/backup-local.ts",
    "test:auth": "playwright test --config playwright.auth.config.ts",
    "test:design": "playwright test --config playwright.design.config.ts",
    "worker": "tsx apps/worker/src/main.ts",
    "db:up": "tsx scripts/db.ts up",
    "db:stop": "tsx scripts/db.ts stop",
    "db:status": "tsx scripts/db.ts status",
    "db:schema": "tsx scripts/db.ts schema",
    "db:shell": "tsx scripts/db.ts shell",
    "db:migrate": "tsx scripts/migrate-local.ts",
    "supabase:preflight": "tsx scripts/supabase-dev.ts",
    "build": "npm run build --workspace @nextsignal/web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "tsx scripts/test-e2e.ts",
    "test:postgres": "tsx scripts/test-postgres.ts",
    "test:import": "tsx scripts/test-postgres.ts import",
    "test:local-persistence": "tsx scripts/verify-local-persistence.ts",
    "check:all": "npm run check && npm run test:postgres && npm run test:import && npm run test:e2e && npm run test:local-persistence",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run scan:secrets && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "supabase": "3.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
