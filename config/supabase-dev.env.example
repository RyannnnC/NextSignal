# Proposed inputs for the development database preflight and migration runner.
# Copy to .env.supabase-dev.local and supply values locally. The current app does not load this file.
# Obtain the project reference, connection string and CA certificate from the development project.
NEXTSIGNAL_SUPABASE_DEV_PROJECT_REF=
NEXTSIGNAL_SUPABASE_DEV_MIGRATION_URL=
NEXTSIGNAL_SUPABASE_DEV_CA_FILE=
